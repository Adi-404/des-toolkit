# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets stay on your machine.

# ── Clerk auth (required for /moodboard, /clipboard, /notes-pad) ──
# Get keys at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional but recommended — point Clerk at our local sign-in/up pages
# rather than the hosted Clerk domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/moodboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/moodboard

# ── Public site URL ──
# The absolute base used by metadata, OG/Twitter unfurls, sitemap.xml,
# robots.txt, and llms.txt. Leaving this unset locally falls back to
# http://localhost:3000. Set this to your deploy URL in production.
# Must be a full URL, no trailing slash, no spaces. Example:
#   NEXT_PUBLIC_SITE_URL=https://des-toolkit.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Database (Turso / libSQL) ──
# For local development, leaving this unset uses a file at ./data/des-toolkit.db
# For production (Vercel), create a Turso DB and paste the URL + token below:
#   1. brew install tursodatabase/tap/turso  (or curl -sSfL https://get.tur.so/install.sh | bash)
#   2. turso auth signup
#   3. turso db create des-toolkit
#   4. turso db show des-toolkit --url        →  TURSO_DATABASE_URL
#   5. turso db tokens create des-toolkit     →  TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

